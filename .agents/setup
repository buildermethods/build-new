#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

step() {
  printf '\n==> %s\n' "$1"
}

step "Installing PostgreSQL"
if ! dpkg-query -W -f='${Status}' postgresql 2>/dev/null | grep -Fq "install ok installed"; then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends postgresql
fi

step "Installing pinned Ruby and Node.js"
mise_bin="$HOME/.local/bin/mise"
if [[ ! -x "$mise_bin" ]]; then
  curl -fsSL https://mise.run | MISE_INSTALL_PATH="$mise_bin" sh
fi

export PATH="$HOME/.local/share/mise/shims:$HOME/.local/bin:$PATH"
export MISE_YES=1
ruby_version="$(tr -d '[:space:]' < .ruby-version)"
node_version="$(tr -d '[:space:]' < .nvmrc)"
"$mise_bin" use --global "ruby@$ruby_version" "node@$node_version"

profile_marker="# build-new mise activation"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# build-new mise activation
export PATH="$HOME/.local/bin:$PATH"
eval "$(mise activate bash)"
EOF
fi

step "Installing Ruby dependencies"
bundler_version="$(awk '/^BUNDLED WITH$/ { getline; gsub(/^[[:space:]]+/, ""); print; exit }' Gemfile.lock)"
if ! gem list --installed --exact bundler --version "$bundler_version" >/dev/null; then
  gem install bundler --version "$bundler_version" --no-document
fi
bundle "_${bundler_version}_" install --jobs "$(nproc)" --retry 3

step "Installing JavaScript dependencies"
npm ci

step "Configuring PostgreSQL"
postgresql_version="$(pg_config --version | awk '{ print $2 }' | cut -d. -f1)"
postgresql_config="/etc/postgresql/$postgresql_version/main/postgresql.conf"
hba_config="/etc/postgresql/$postgresql_version/main/pg_hba.conf"

sudo sed -E -i \
  '/^host[[:space:]]+all[[:space:]]+all[[:space:]]+(127\.0\.0\.1\/32|::1\/128)/ s/(scram-sha-256|md5)$/trust/' \
  "$hba_config"

sudo sed -E -i \
  -e 's/^#?fsync[[:space:]]*=.*/fsync = off/' \
  -e 's/^#?synchronous_commit[[:space:]]*=.*/synchronous_commit = off/' \
  "$postgresql_config"

sudo systemctl enable --now postgresql
sudo systemctl restart postgresql

if ! pg_isready -h localhost >/dev/null; then
  echo "PostgreSQL did not become ready" >&2
  exit 1
fi

sudo -u postgres psql --set=role_name="$USER" --no-psqlrc --quiet <<'SQL'
SELECT format('CREATE ROLE %I LOGIN SUPERUSER CREATEDB CREATEROLE', :'role_name')
WHERE NOT EXISTS (SELECT FROM pg_roles WHERE rolname = :'role_name') \gexec
SQL

step "Preparing the development database"
bin/rails db:prepare

step "Orb setup complete"
